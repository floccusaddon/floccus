<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".WebViewErrorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/webview_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/webview_error_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/webview_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/webview_error_message"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/webview_error_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="14sp"
            tools:text="Installed WebView version: 77.0.3865.92" />

        <Button
            android:id="@+id/webview_error_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webview_error_update" />
    </LinearLayout>
</ScrollView>
